{
  "schemaVersion": 1,
  "exampleOnly": true,
  "presets": [
    {
      "id": "wav-follow-24",
      "label": "WAV 跟随来源 24-bit",
      "container": "wav",
      "codec": "pcm_s24le",
      "sampleRateMode": "source",
      "sampleRate": null,
      "bitDepth": 24,
      "dither": false,
      "keepSourceWav": false
    },
    {
      "id": "wav-96-float",
      "label": "WAV 96 kHz 32-bit 浮点",
      "container": "wav",
      "codec": "pcm_f32le",
      "sampleRateMode": "fixed",
      "sampleRate": 96000,
      "bitDepth": 32,
      "dither": false,
      "keepSourceWav": false
    },
    {
      "id": "mp3-48-192",
      "label": "MP3 48 kHz 192 kbps",
      "container": "mp3",
      "codec": "libmp3lame",
      "sampleRateMode": "fixed",
      "sampleRate": 48000,
      "rateControl": "cbr",
      "bitrateKbps": 192,
      "keepSourceWav": false
    },
    {
      "id": "aac-m4a-48-192",
      "label": "AAC / M4A 48 kHz 192 kbps",
      "container": "mp4",
      "extension": "m4a",
      "codec": "aac",
      "profile": "aac_low",
      "sampleRateMode": "fixed",
      "sampleRate": 48000,
      "rateControl": "target-bitrate",
      "bitrateKbps": 192,
      "keepSourceWav": false
    },
    {
      "id": "aac-adts-44-192",
      "label": "AAC / ADTS 44.1 kHz 192 kbps",
      "container": "adts",
      "extension": "aac",
      "codec": "aac",
      "profile": "aac_low",
      "sampleRateMode": "fixed",
      "sampleRate": 44100,
      "rateControl": "target-bitrate",
      "bitrateKbps": 192,
      "keepSourceWav": false
    }
  ]
}
