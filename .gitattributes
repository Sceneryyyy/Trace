# Generated PDFs must keep their exact bytes; do not apply text conversion or EOL filters.
output/pdf/*.pdf binary
# Preserve the upstream README snapshot exactly after retiring its build tree.
references/prism/README.original.txt binary
# Provenance and security evidence use byte identities across Linux/Windows.
native/vendor/prism-fft/** -text
package-lock.json -text

# Preserve the original EBU test archive and official documents byte for byte.
references/ebu-loudness-test-set-v5/*.zip binary
references/ebu-loudness-test-set-v5/archive-parts/* binary
references/ebu-loudness-test-set-v5/*.pdf binary
# The extracted upstream readme keeps its original CRLFs and trailing blank lines.
references/ebu-loudness-test-set-v5/readme.txt binary
# Internal EBU material is available to private Git clones, not release source ZIPs.
references/ebu-loudness-test-set-v5 export-ignore
references/ebu-loudness-test-set-v5/** export-ignore
references/ffmpeg-9.0.2/README.publisher.txt -text whitespace=-blank-at-eol,-blank-at-eof
references/ffmpeg-9.0.2/LICENSE.publisher.txt -text
references/ffmpeg-9.0.2/COPYING.GPLv3 -text
references/ffmpeg-9.0.2/LICENSE.upstream.md -text

references/ffmpeg-9.0.2/LAME-LGPL.txt -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
references/ffmpeg-9.0.2/LAME-README.txt -text whitespace=-blank-at-eol,-blank-at-eof
references/trace-ffmpeg/*.json -text
references/trace-ffmpeg/*.txt -text
references/trace-ffmpeg/COPYING.GPLv3 -text
references/trace-ffmpeg/LICENSE.upstream.md -text
references/trace-ffmpeg/LAME-LGPL.txt -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
references/trace-ffmpeg/LAME-README.txt -text whitespace=-blank-at-eol,-blank-at-eof
tools/codec/*.cjs text eol=lf
tools/release/dependency-sources.cjs text eol=lf
