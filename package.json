{
  "name": "trace",
  "version": "0.1.0-preview.31",
  "description": "Trace 声迹 · Audio Recorder & Analyzer",
  "main": "./out-trace/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --config electron-vite.trace.config.ts",
    "build": "npm run build:trace",
    "start": "node tools/trace.cjs App",
    "preview": "electron-vite preview --config electron-vite.trace.config.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.node.json",
    "test": "npm run test:trace",
    "install:trace-sdk": "node tools/install-trace-sdk.cjs",
    "build:native": "npm run build:trace-engine",
    "rebuild:native": "npm run build:trace-engine",
    "dist": "npm run build && npm run build:trace-engine && node tools/package-trace.cjs",
    "dist:win": "npm run dist",
    "build:trace": "electron-vite build --config electron-vite.trace.config.ts",
    "start:trace": "npm run start",
    "build:trace-engine": "node tools/build-engine.cjs",
    "test:trace": "node scripts/run-trace-tests.mjs portable",
    "test:trace-native": "node scripts/run-trace-tests.mjs native",
    "test:trace-all": "node scripts/run-trace-tests.mjs all",
    "test:trace-contracts": "node --test test/trace-contracts.test.mjs",
    "test:trace-report": "node --test test/probe-report.test.mjs",
    "test:trace-recording": "node --test test/recording-service.test.mjs test/recovery-inventory.test.mjs",
    "test:trace-timeline": "node --test test/session-timeline.test.mjs",
    "test:trace-workspace": "node --test test/workspace-layout.test.mjs",
    "test:trace-m7": "node tools/m7/verify.cjs",
    "build:trace-diagnostics": "node tools/diagnostics/run.cjs build",
    "trace:diagnostics": "node tools/diagnostics/run.cjs",
    "check:independence": "node tools/independence/check.cjs",
    "check:security": "node tools/release/security-audit.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sceneryyyy/Trace"
  },
  "author": "Trace contributors",
  "license": "GPL-3.0-only",
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "node-addon-api": "8.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/node": "24.12.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "7zip-bin": "5.2.0",
    "electron": "42.11.10",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "esbuild": "0.25.12",
    "node-gyp": "13.1.0",
    "pe-library": "0.4.1",
    "postcss": "8.5.28",
    "resedit": "1.7.2",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "yauzl": "2.10.0"
  },
  "overrides": {
    "@electron/get": "5.1.0"
  }
}
